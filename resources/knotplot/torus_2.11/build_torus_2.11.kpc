% build_torus_2.11.kpc
reset all
torus 2 11 300
mode cb

centre
fitto mindist 1.05

collision fast
close = 1.0
max-dr = 0.01

mechforce = on
elecforce = on
bendforce = on
bencon = 1.0

stusplit = 0
dstep = 1

bradius = 0.1
cradius = 0.05

energy model MD
energy

echo CHECKPOINT analytic_D1
safe
dowker
lnknum
length
distance
angle
acn
save knots/torus_2.11/torus_2.11_analytic_D1.txt

ago 1000
echo CHECKPOINT trial_001k
safe
dowker
lnknum
length
distance
angle
acn
save knots/torus_2.11/torus_2.11_trial_001k.txt

